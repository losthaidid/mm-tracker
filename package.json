  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "jsdom": "30.1.2",
    "prettier": "3.6.2"
  }
}
